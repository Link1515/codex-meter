{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Meter",
  "version": "0.1.0",
  "identifier": "dev.codex-meter.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm typecheck",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Meter",
        "width": 330,
        "height": 300,
        "minWidth": 330,
        "minHeight": 300,
        "maxWidth": 330,
        "maxHeight": 300,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
